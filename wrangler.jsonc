{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "articles",
  "main": "worker.js",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
